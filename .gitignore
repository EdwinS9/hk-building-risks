###############################################################################
# HK Building Risk — monorepo .gitignore
# Apps: Node/TS (Vite, React)   |   ML: Python (uv, PyTorch, Jupyter, geo)
# NOTE: this repo deliberately TRACKS some data artifacts — do not add blanket
#       *.csv / *.sql / *.png / *.pptx ignores here (see ml/, docs/).
###############################################################################

# =============================================================================
# Node / JavaScript / TypeScript
# =============================================================================
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.js
.pnp.cjs
.pnp.loader.mjs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/
.npm/
.node_repl_history
*.tgz
package-lock.json.*
.lock-wscript

# ----- Build output -----
dist/
dist-ssr/
build/
out/
lib-cov/
.vite/
.vite-inspect/
*.tsbuildinfo
tsconfig.tsbuildinfo
.rollup.cache/
.swc/

# ----- Framework / bundler caches -----
.next/
.nuxt/
.svelte-kit/
.astro/
.docusaurus/
.cache/
.parcel-cache/
.turbo/
.rspack/
.webpack/
.storybook-out/
storybook-static/

# ----- Lint / format caches -----
.eslintcache
.stylelintcache
.prettiercache

# ----- PWA / service worker (resident-app) -----
dev-dist/
sw.js
workbox-*.js
**/public/sw.js
**/public/workbox-*.js

# =============================================================================
# Testing & coverage
# =============================================================================
coverage/
*.lcov
.nyc_output/
.vitest-cache/
.vitest-result.json
test-results/
playwright-report/
playwright/.cache/
blob-report/
__snapshots__/*.snap.new
.cypress/screenshots/
.cypress/videos/

# =============================================================================
# Python (uv / pip / venv)
# =============================================================================
.venv/
venv/
env/
ENV/
.python-version.local
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.pdm-python
.pdm-build/
__pypackages__/
.uv/

# ----- Python build / packaging -----
*.egg
*.egg-info/
.eggs/
develop-eggs/
sdist/
wheels/
*.whl
.installed.cfg
MANIFEST

# ----- Python tooling caches -----
