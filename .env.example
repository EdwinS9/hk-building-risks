# ─── Supabase (required) ───────────────────────────────────────────────────
# From the Supabase dashboard → Project Settings → API.
# These are PUBLIC values — they're safe to ship to the browser because the
# database is protected by Row Level Security policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── MapTiler (optional) ───────────────────────────────────────────────────
# If set, the map uses MapTiler's `dataviz-dark` / `dataviz-light` vector
# styles. Without it, the app falls back to CARTO dark/light raster tiles
# automatically. Get a free key at https://www.maptiler.com/
VITE_MAPTILER_KEY=
